# YogShakti — environment variables (TEMPLATE)
#
# This file is SAFE for Git. It contains no real credentials — only the shape
# of the values. The real values live in .env, which is git-ignored.
#
# HOW TO USE
#   1. Copy this file:  cp .env.example .env
#   2. Put your real values in .env
#   3. Never commit .env


# =============================================================================
# DATABASE_URL  (required)
# =============================================================================
#
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
#
# --- Local development ---
#
# Local Homebrew Postgres on macOS usually needs no password, so the
# :PASSWORD part is simply left out:
#
#   postgresql://your_mac_username@localhost:5432/yogshakti?schema=public
#
# Create the database once before running migrations:  createdb yogshakti
#
# --- Production (hosted PostgreSQL such as Neon) ---
#
# Use the POOLED connection string. Serverless functions open a new database
# connection on every request, and the pooler is what stops the database
# running out of them. Neon's pooled host contains "-pooler".
# Hosted providers also require TLS, hence sslmode=require.
#
#   postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/yogshakti?sslmode=require
#
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/yogshakti?schema=public"


# =============================================================================
# DIRECT_URL  (optional — production only)
# =============================================================================
#
# Leave this UNSET for local development. It falls back to DATABASE_URL.
#
# Only needed with a hosted database that has connection pooling. Set it to
# the DIRECT (non-pooled) connection string — the same host WITHOUT "-pooler".
#
# Why: `prisma migrate` takes a PostgreSQL advisory lock so two deploys cannot
# migrate at the same time. Transaction-mode poolers do not support those
# locks, so migrations run through the pooler hang or fail. Only the Prisma
# CLI uses this value; the running app always uses DATABASE_URL.
#
# DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/yogshakti?sslmode=require"


# =============================================================================
# Later phases
# =============================================================================
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"
