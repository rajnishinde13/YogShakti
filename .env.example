# YogShakti — environment variables (TEMPLATE)
#
# This file is SAFE for Git. It contains no real credentials — only the shape
# of the values. The real values live in .env, which is git-ignored.
#
# HOW TO USE
#   1. Copy this file:  cp .env.example .env
#   2. Put your real values in .env
#   3. Never commit .env

# ---- PostgreSQL (required from Phase 2 onward) ----
#
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
#
# Local Homebrew Postgres on macOS usually needs no password, so the
# :PASSWORD part is simply left out:
#   postgresql://your_mac_username@localhost:5432/yogshakti?schema=public
#
# Create the database once before running migrations:  createdb yogshakti
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/yogshakti?schema=public"

# ---- Later phases ----
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"
