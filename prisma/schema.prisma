// schema.prisma
//
// This file is the single source of truth for the database structure.
// You describe the shape you want here, then `prisma migrate dev` figures
// out the SQL needed to make the real database match it.

// The generator decides what client code Prisma writes for you.
//
// "prisma-client-js" emits plain JavaScript. Prisma 7's newer default,
// "prisma-client", emits TypeScript instead — which this project does not use.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // The connection string comes from prisma.config.mjs, which reads .env.
}

// One yoga pose. Mirrors the objects currently in data/asanas.js.
model Asana {
  // @id marks the primary key. autoincrement() lets Postgres number rows.
  id Int @id @default(autoincrement())

  // The URL-friendly version of the name: "Adho Mukha Svanasana" becomes
  // "adho-mukha-svanasana", giving the address /asana/adho-mukha-svanasana.
  //
  // @unique does two jobs here. It stops two poses claiming the same address,
  // and it is what lets findUnique() look a pose up by slug — Prisma only
  // allows findUnique() on columns the database guarantees are unique.
  slug String @unique

  // @unique stops the same pose being inserted twice, which also lets the
  // seed script safely re-run using upsert().
  name        String @unique
  englishName String
  level       String
  category    String

  // @db.Text asks Postgres for an unlimited-length text column instead of
  // the default varchar, since descriptions can get long.
  description String @db.Text

  // String[] becomes a real PostgreSQL text array — a Postgres feature that
  // most other databases do not have.
  benefits String[]

  // ---- Detail content ----------------------------------------------------
  //
  // Six lists and two pieces of prose. Lists are arrays because the UI renders
  // each entry as its own bullet; breathing and duration are single strings
  // because splitting them into items would be artificial.

  steps             String[] // ordered instructions, 4-8 of them
  bodyAreas         String[] // muscles and joints involved
  commonMistakes    String[]
  beginnerTips      String[]
  precautions       String[]
  contraindications String[]

  breathing String @db.Text // when to inhale and exhale
  duration  String // e.g. "30-60 seconds each side"

  // ---- Tradition and sources ---------------------------------------------
  //
  // ALL OPTIONAL. A pose with none of these set simply does not show the
  // "Tradition & Sources" section — the page renders only what exists.
  //
  // Rule for filling these in: leave a field null rather than guessing.
  // A blank field is honest; an invented chapter and verse is not, and is
  // the single most common error in yoga reference material.

  sanskritName    String? // the Sanskrit name in Latin script
  devanagari      String? // the name in Devanagari script, e.g. ताडासन
  transliteration String? // IAST transliteration, e.g. tāḍāsana
  tradition       String? // e.g. "Hatha yoga", "Modern postural yoga"

  sourceText    String? // e.g. "Hatha Yoga Pradipika"
  sourceChapter String? // kept as String — sources use "1", "II", "2.a"
  sourceVerse   String? // e.g. "28-29". Also a String, for ranges.

  historicalNotes String? @db.Text // short, hedged context

  // ---- Visuals -----------------------------------------------------------

  // Reserved for a real photograph or illustration. Nullable, because no pose
  // has one yet — the UI draws a placeholder whenever this is empty. Adding
  // images later needs no migration, just values in this column.
  //
  // Only the ADDRESS of an image is stored, never the image data itself.
  // Binary files belong in object storage or a CDN, not in table rows.
  imageUrl String?

  // Alternative text, for screen readers and for when an image fails to load.
  // If this is null the UI falls back to "<name> — <englishName>".
  imageAlt String?

  // Attribution. Displayed as a caption beneath the image when present, so
  // credit and licence terms travel with the picture rather than living in
  // somebody's notes.
  imageSource  String? // photographer, illustrator or source page
  imageLicense String? // e.g. "CC BY-SA 4.0"

  // Kept for now but NO LONGER USED by the UI, which draws an abstract mark
  // instead. Optional so new poses need not supply one. Safe to drop in a
  // later migration once you are happy with the new visuals.
  emoji String?

  // Bookkeeping columns. Prisma fills both in automatically.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
